  <dashboards>
    <dashboard name="Sales">
      <style />
      <size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200" />
      <datasources>
        <datasource caption="monthly" name="federated.monthly" />
        <datasource caption="countries" name="federated.countries" />
      </datasources>
      <zones>
        <zone h="100000" id="100" type-v2="layout-basic" w="100000" x="0" y="0">
          <zone id="1" x="2000" y="1500" w="96000" h="6000" type-v2="text">
            <formatted-text>
              <run fontsize="24" bold="true" fontcolor="#173b46">SALES</run>
            </formatted-text>
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
