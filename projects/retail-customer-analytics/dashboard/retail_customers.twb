    <worksheet name="Cohort purchasing">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#242424" fontsize="12">Cohort purchasing</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Cohorts" name="federated.cohorts" />
          </datasources>
          <datasource-dependencies datasource="federated.cohorts">
            <column name="[cohort_month]" caption="Cohort Month" datatype="date" role="dimension" type="ordinal" />
            <column name="[month_index]" caption="Months after first observed purchase" datatype="integer" role="dimension" type="nominal" />
            <column name="[segment]" caption="Customer group · 1 Dec 2011" datatype="string" role="dimension" type="nominal" />
            <column name="[cohort_customers]" caption="Cohort Customers" datatype="integer" role="measure" type="quantitative" default-format="#,##0" />
            <column name="[active_customers]" caption="Active Customers" datatype="integer" role="measure" type="quantitative" default-format="#,##0" />
            <column name="[repeat_rate]" caption="Repeat Rate" datatype="real" role="measure" type="quantitative" default-format="p0.0%" />
            <column name="[cohort_label]" caption="First observed purchase month" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="STR(DATEPART('year', [cohort_month])) + '-' + RIGHT('0' + STR(DATEPART('month', [cohort_month])), 2)" />
            </column>
            <column name="[cohort_rate]" caption="Monthly purchasing share" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="SUM([active_customers]) / SUM([cohort_customers])" />
            </column>
            <column-instance column="[active_customers]" derivation="Sum" name="[sum:active_customers:qk]" pivot="key" type="quantitative" />
            <column-instance column="[cohort_customers]" derivation="Sum" name="[sum:cohort_customers:qk]" pivot="key" type="quantitative" />
            <column-instance column="[cohort_label]" derivation="None" name="[none:cohort_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[cohort_rate]" derivation="User" name="[usr:cohort_rate:qk]" pivot="key" type="quantitative" />
            <column-instance column="[month_index]" derivation="None" name="[none:month_index:nk]" pivot="key" type="nominal" />
            <column-instance column="[segment]" derivation="None" name="[none:segment:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.cohorts].[none:month_index:nk]">
            <groupfilter function="union">
              <groupfilter function="member" level="[none:month_index:nk]" member="1" />
              <groupfilter function="member" level="[none:month_index:nk]" member="2" />
              <groupfilter function="member" level="[none:month_index:nk]" member="3" />
              <groupfilter function="member" level="[none:month_index:nk]" member="4" />
              <groupfilter function="member" level="[none:month_index:nk]" member="5" />
              <groupfilter function="member" level="[none:month_index:nk]" member="6" />
              <groupfilter function="member" level="[none:month_index:nk]" member="7" />
              <groupfilter function="member" level="[none:month_index:nk]" member="8" />
              <groupfilter function="member" level="[none:month_index:nk]" member="9" />
              <groupfilter function="member" level="[none:month_index:nk]" member="10" />
              <groupfilter function="member" level="[none:month_index:nk]" member="11" />
            </groupfilter>
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="false" />
            <format attr="background-color" value="#f5f1e8" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" value="off" />
          </style-rule>
          <style-rule element="header">
            <format attr="width" field="[federated.cohorts].[none:cohort_label:nk]" value="160" />
          </style-rule>
          <style-rule element="mark">
            <encoding attr="color" field="[federated.cohorts].[usr:cohort_rate:qk]" min="0" max="1" type="custom-interpolated">
              <color-palette custom="true" name="" type="ordered-sequential">
                <color>#f5f1e8</color>
                <color>#245f58</color>
              </color-palette>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Square" />
            <encodings>
              <tooltip column="[federated.cohorts].[usr:cohort_rate:qk]" />
              <text column="[federated.cohorts].[usr:cohort_rate:qk]" />
              <color column="[federated.cohorts].[usr:cohort_rate:qk]" />
              <tooltip column="[federated.cohorts].[sum:cohort_customers:qk]" />
              <tooltip column="[federated.cohorts].[sum:active_customers:qk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true">&lt;[federated.cohorts].[none:cohort_label:nk]&gt;
</run>
                <run>Monthly purchasing share: &lt;[federated.cohorts].[usr:cohort_rate:qk]&gt;
</run>
                <run>cohort customers: &lt;[federated.cohorts].[sum:cohort_customers:qk]&gt;
</run>
                <run>active customers: &lt;[federated.cohorts].[sum:active_customers:qk]&gt;
</run>
                <run>First observed purchase cohort. Unobserved future months remain blank.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
                <format attr="size" value="1" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.cohorts].[none:cohort_label:nk]</rows>
        <cols>[federated.cohorts].[none:month_index:nk]</cols>
      </table>
