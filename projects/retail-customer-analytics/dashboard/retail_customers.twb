    </worksheet>
    <worksheet name="Comparable product changes · all markets">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#242424" fontsize="12">Comparable product changes · all markets</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Changes" name="federated.changes" />
          </datasources>
          <datasource-dependencies datasource="federated.changes">
            <column name="[product_key]" caption="Product Key" datatype="string" role="dimension" type="nominal" />
            <column name="[product_label]" caption="Product Label" datatype="string" role="dimension" type="nominal" />
            <column name="[prior_value]" caption="Prior Value" datatype="real" role="measure" type="quantitative" default-format="£#,##0.00" />
            <column name="[current_value]" caption="Current Value" datatype="real" role="measure" type="quantitative" default-format="£#,##0.00" />
            <column name="[value_change]" caption="Jan–Nov 2011 less Jan–Nov 2010 · GBP" datatype="real" role="measure" type="quantitative" default-format="£#,##0.00" />
            <column name="[prior_orders]" caption="Prior Orders" datatype="integer" role="measure" type="quantitative" default-format="#,##0" />
            <column name="[current_orders]" caption="Current Orders" datatype="integer" role="measure" type="quantitative" default-format="#,##0" />
            <column name="[current_penetration]" caption="Current Penetration" datatype="real" role="measure" type="quantitative" default-format="p0.0%" />
            <column name="[product_display]" caption="Product code and description" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="[product_key] + ' — ' + [product_label]" />
            </column>
            <column name="[absolute_change]" caption="Absolute Change" datatype="real" role="measure" type="quantitative" default-format="#,##0">
              <calculation class="tableau" formula="ABS([value_change])" />
            </column>
            <column-instance column="[current_orders]" derivation="Sum" name="[sum:current_orders:qk]" pivot="key" type="quantitative" />
            <column-instance column="[current_value]" derivation="Sum" name="[sum:current_value:qk]" pivot="key" type="quantitative" />
            <column-instance column="[prior_value]" derivation="Sum" name="[sum:prior_value:qk]" pivot="key" type="quantitative" />
            <column-instance column="[product_display]" derivation="None" name="[none:product_display:nk]" pivot="key" type="nominal" />
            <column-instance column="[value_change]" derivation="Sum" name="[sum:value_change:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.changes].[none:product_display:nk]">
            <groupfilter count="20" end="top" function="end" units="records">
              <groupfilter direction="DESC" expression="SUM([absolute_change])" function="order">
                <groupfilter function="level-members" level="[none:product_display:nk]" />
              </groupfilter>
            </groupfilter>
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="false" />
            <format attr="background-color" value="#f5f1e8" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" value="off" />
          </style-rule>
          <style-rule element="header">
            <format attr="width" field="[federated.changes].[none:product_display:nk]" value="230" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <tooltip column="[federated.changes].[sum:value_change:qk]" />
              <text column="[federated.changes].[sum:value_change:qk]" />
              <tooltip column="[federated.changes].[sum:prior_value:qk]" />
              <tooltip column="[federated.changes].[sum:current_value:qk]" />
              <tooltip column="[federated.changes].[sum:current_orders:qk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true">&lt;[federated.changes].[none:product_display:nk]&gt;
</run>
                <run>Jan–Nov 2011 less Jan–Nov 2010 · GBP: &lt;[federated.changes].[sum:value_change:qk]&gt;
</run>
                <run>prior value: &lt;[federated.changes].[sum:prior_value:qk]&gt;
</run>
                <run>current value: &lt;[federated.changes].[sum:current_value:qk]&gt;
</run>
                <run>current orders: &lt;[federated.changes].[sum:current_orders:qk]&gt;
</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#245f58" />
                <format attr="mark-labels-show" value="true" />
                <format attr="size" value="0.65" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.changes].[none:product_display:nk]</rows>
        <cols>[federated.changes].[sum:value_change:qk]</cols>
      </table>
      <simple-id uuid="{F76CECD6-074C-5990-8FE1-ED4D8A00131E}" />
    </worksheet>
