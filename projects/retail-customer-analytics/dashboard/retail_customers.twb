          <zone id="1" x="2000" y="1500" w="96000" h="6000" type-v2="text">
            <formatted-text>
              <run fontsize="24" bold="true" fontcolor="#173b46">REPEAT PURCHASE</run>
            </formatted-text>
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="5" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="2" x="2000" y="8000" w="96000" h="8000" type-v2="text">
            <formatted-text>
              <run fontsize="11" bold="false" fontcolor="#173b46">Known customers only | First observed purchase cohort | M0–M11
What share of each cohort returns in the following months?</run>
            </formatted-text>
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="5" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="3" x="2000" y="18000" w="96000" h="72000" name="Cohort return rate">
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="5" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="90" x="2000" y="92000" w="96000" h="6500" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173b46">Rate = active customers / original cohort size. M0 is the first observed month, not confirmed acquisition. Future months are null, not 0%.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="5" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
        </zone>
      </zones>
      <simple-id uuid="{D5234AE4-1A33-5210-A55B-BA351822066B}" />
    </dashboard>
