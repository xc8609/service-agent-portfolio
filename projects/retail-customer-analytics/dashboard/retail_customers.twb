              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="90" x="2000" y="92000" w="96000" h="6500" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173b46">Active/recent: purchase within 90 days. Repeat: at least 2 orders in the last 12 months. Lapsed is a historical segment label, not confirmed churn.</run>
