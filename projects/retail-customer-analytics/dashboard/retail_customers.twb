    <worksheet name="Merchandise sales">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#242424" fontsize="12">Merchandise sales</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Products" name="federated.products" />
          </datasources>
          <datasource-dependencies datasource="federated.products">
            <column name="[invoice_key]" caption="Purchase invoice" datatype="string" role="dimension" type="nominal" />
            <column name="[occurred_date]" caption="Purchase date" datatype="date" role="dimension" type="ordinal" />
            <column name="[country]" caption="Recorded country" datatype="string" role="dimension" type="nominal" />
            <column name="[product_key]" caption="Product Key" datatype="string" role="dimension" type="nominal" />
            <column name="[product_label]" caption="Product Label" datatype="string" role="dimension" type="nominal" />
            <column name="[customer_key]" caption="Identified customer" datatype="string" role="dimension" type="nominal" />
            <column name="[segment]" caption="Customer group · 1 Dec 2011" datatype="string" role="dimension" type="nominal" />
            <column name="[units]" caption="Units" datatype="real" role="measure" type="quantitative" default-format="#,##0" />
            <column name="[recorded_value]" caption="Recorded sales · GBP" datatype="real" role="measure" type="quantitative" default-format="£#,##0.00" />
            <column name="[is_merchandise]" caption="Record type" datatype="string" role="dimension" type="nominal" />
            <column name="[month]" caption="Month" datatype="date" role="dimension" type="ordinal">
              <calculation class="tableau" formula="DATETRUNC('month', [occurred_date])" />
            </column>
            <column name="[product_display]" caption="Product code and description" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="[product_key] + ' — ' + [product_label]" />
            </column>
            <column name="[scope_invoices]" caption="All merchandise invoices in filter scope" datatype="integer" role="measure" type="quantitative" default-format="#,##0">
              <calculation class="tableau" formula="{ FIXED : COUNTD([invoice_key]) }" />
            </column>
            <column name="[penetration]" caption="Order penetration" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="COUNTD([invoice_key]) / MIN([scope_invoices])" />
            </column>
            <column-instance column="[country]" derivation="None" name="[none:country:nk]" pivot="key" type="nominal" />
            <column-instance column="[is_merchandise]" derivation="None" name="[none:is_merchandise:nk]" pivot="key" type="nominal" />
            <column-instance column="[occurred_date]" derivation="None" name="[none:occurred_date:qk]" pivot="key" type="quantitative" />
            <column-instance column="[product_key]" derivation="None" name="[none:product_key:nk]" pivot="key" type="nominal" />
            <column-instance column="[recorded_value]" derivation="Sum" name="[sum:recorded_value:qk]" pivot="key" type="quantitative" />
            <column-instance column="[segment]" derivation="None" name="[none:segment:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.products].[none:country:nk]" filter-group="21" context="true">
            <groupfilter function="level-members" level="[none:country:nk]" />
          </filter>
          <filter class="quantitative" column="[federated.products].[none:occurred_date:qk]" filter-group="22" context="true" included-values="in-range">
            <min>#2011-01-01#</min>
            <max>#2011-11-30#</max>
          </filter>
          <filter class="categorical" column="[federated.products].[none:segment:nk]" filter-group="23" context="true">
            <groupfilter function="level-members" level="[none:segment:nk]" />
          </filter>
          <filter class="categorical" column="[federated.products].[none:is_merchandise:nk]" context="true">
            <groupfilter function="member" level="[none:is_merchandise:nk]" member="&quot;Merchandise&quot;" />
          </filter>
          <slices>
            <column>[federated.products].[none:country:nk]</column>
            <column>[federated.products].[none:occurred_date:qk]</column>
            <column>[federated.products].[none:segment:nk]</column>
            <column>[federated.products].[none:is_merchandise:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="false" />
            <format attr="background-color" value="#f5f1e8" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <tooltip column="[federated.products].[sum:recorded_value:qk]" />
              <text column="[federated.products].[sum:recorded_value:qk]" />
            </encodings>
