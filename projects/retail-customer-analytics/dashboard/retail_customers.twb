  <actions>
    <action caption="Select market" name="[Select market]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="01 Trading performance" type="sheet" worksheet="Markets" />
      <link caption="Select market" delimiter="," escape="\" expression="tsl:01%20Trading%20performance?%5Bfederated.trading%5D.%5Bcountry%5D~s0=&lt;[country]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Markets" />
        <param name="target" value="01 Trading performance" />
      </command>
    </action>
    <action caption="Select customer group" name="[Select customer group]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="02 Client development" type="sheet" worksheet="Customer groups" />
      <link caption="Select customer group" delimiter="," escape="\" expression="tsl:02%20Client%20development?%5Bfederated.customers%5D.%5Bsegment%5D~s0=&lt;[segment]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Customer groups,Cohort purchasing" />
        <param name="target" value="02 Client development" />
      </command>
    </action>
    <action caption="Select cohort group" name="[Select cohort group]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="02 Client development" type="sheet" worksheet="Customer groups" />
      <link caption="Select cohort group" delimiter="," escape="\" expression="tsl:02%20Client%20development?%5Bfederated.cohorts%5D.%5Bsegment%5D~s0=&lt;[segment]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Customer groups,Identified customers,Client sales · 12 months,Repeat within 90 days" />
        <param name="target" value="02 Client development" />
      </command>
    </action>
    <action caption="Select product" name="[Select product]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="03 Product preferences" type="sheet" worksheet="Leading products · top 15" />
      <link caption="Select product" delimiter="," escape="\" expression="tsl:03%20Product%20preferences?%5Bfederated.products%5D.%5Bproduct_key%5D~s0=&lt;[product_key]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Leading products · top 15" />
        <param name="target" value="03 Product preferences" />
      </command>
    </action>
  </actions>
  <worksheets>
    <worksheet name="Recorded sales">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#242424" fontsize="12">Recorded sales</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Trading" name="federated.trading" />
          </datasources>
          <datasource-dependencies datasource="federated.trading">
            <column name="[invoice_key]" caption="Purchase invoice" datatype="string" role="dimension" type="nominal" />
            <column name="[occurred_date]" caption="Purchase date" datatype="date" role="dimension" type="ordinal" />
            <column name="[country]" caption="Recorded country" datatype="string" role="dimension" type="nominal" />
            <column name="[product_key]" caption="Product Key" datatype="string" role="dimension" type="nominal" />
            <column name="[product_label]" caption="Product Label" datatype="string" role="dimension" type="nominal" />
            <column name="[customer_key]" caption="Identified customer" datatype="string" role="dimension" type="nominal" />
            <column name="[segment]" caption="Customer group · 1 Dec 2011" datatype="string" role="dimension" type="nominal" />
            <column name="[units]" caption="Units" datatype="real" role="measure" type="quantitative" default-format="#,##0" />
            <column name="[recorded_value]" caption="Recorded sales · GBP" datatype="real" role="measure" type="quantitative" default-format="£#,##0.00" />
            <column name="[is_merchandise]" caption="Record type" datatype="string" role="dimension" type="nominal" />
            <column name="[month]" caption="Month" datatype="date" role="dimension" type="ordinal">
              <calculation class="tableau" formula="DATETRUNC('month', [occurred_date])" />
            </column>
            <column name="[average_invoice]" caption="Average invoice · GBP" datatype="real" role="measure" type="quantitative" default-format="£#,##0.00">
              <calculation class="tableau" formula="SUM([recorded_value]) / COUNTD([invoice_key])" />
            </column>
            <column-instance column="[country]" derivation="None" name="[none:country:nk]" pivot="key" type="nominal" />
            <column-instance column="[occurred_date]" derivation="None" name="[none:occurred_date:qk]" pivot="key" type="quantitative" />
            <column-instance column="[recorded_value]" derivation="Sum" name="[sum:recorded_value:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.trading].[none:country:nk]" filter-group="11" context="true">
            <groupfilter function="level-members" level="[none:country:nk]" />
          </filter>
          <filter class="quantitative" column="[federated.trading].[none:occurred_date:qk]" filter-group="12" context="true" included-values="in-range">
            <min>#2011-01-01#</min>
            <max>#2011-11-30#</max>
          </filter>
          <slices>
            <column>[federated.trading].[none:country:nk]</column>
            <column>[federated.trading].[none:occurred_date:qk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="false" />
            <format attr="background-color" value="#f5f1e8" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <tooltip column="[federated.trading].[sum:recorded_value:qk]" />
              <text column="[federated.trading].[sum:recorded_value:qk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>Recorded sales · GBP: &lt;[federated.trading].[sum:recorded_value:qk]&gt;
