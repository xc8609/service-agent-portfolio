          </zone>
          <zone id="2" x="2000" y="8000" w="96000" h="8000" type-v2="text">
            <formatted-text>
              <run fontsize="11" bold="false" fontcolor="#173b46">UCI Online Retail II | Dec 2009–Nov 2011 | Positive sales records, GBP
Which markets and months contribute the most sales?</run>
            </formatted-text>
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="5" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="3" x="2000" y="18000" w="56000" h="72000" name="Monthly sales value">
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="5" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="4" x="60000" y="18000" w="38000" h="72000" name="Sales by country">
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="5" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone id="90" x="2000" y="92000" w="96000" h="6500" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173b46">Complete months only. Cancellations are separate records, not matched refunds. Hover marks for values; each chart uses its own aggregate source.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="5" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
        </zone>
      </zones>
      <simple-id uuid="{AE600FF2-D889-5CF4-9CB8-C0321D400ABF}" />
    </dashboard>
    <dashboard name="Repeat purchase">
      <style />
      <size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200" />
      <datasources>
        <datasource caption="cohorts" name="federated.cohorts" />
      </datasources>
      <zones>
