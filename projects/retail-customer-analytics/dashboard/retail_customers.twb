            <column name="[repeat_rate]" caption="Cohort return rate" datatype="real" role="measure" type="quantitative" default-format="p0.0%" />
            <column name="[cohort_label]" caption="First observed order month" datatype="string" role="dimension" type="nominal">
              <calculation class="tableau" formula="STR(DATEPART('year', [cohort_month])) + '-' + RIGHT('0' + STR(DATEPART('month', [cohort_month])), 2)" />
            </column>
            <column-instance column="[cohort_label]" derivation="None" name="[none:cohort_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[repeat_rate]" derivation="Avg" name="[avg:repeat_rate:qk]" pivot="key" type="quantitative" />
