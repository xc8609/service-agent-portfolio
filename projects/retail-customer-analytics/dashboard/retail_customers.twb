            <max>#2011-11-30#</max>
          </filter>
          <filter class="categorical" column="[federated.products].[none:segment:nk]" filter-group="23" context="true">
            <groupfilter function="level-members" level="[none:segment:nk]" />
          </filter>
          <filter class="categorical" column="[federated.products].[none:is_merchandise:nk]" context="true">
            <groupfilter function="member" level="[none:is_merchandise:nk]" member="&quot;Merchandise&quot;" />
          </filter>
          <slices>
            <column>[federated.products].[none:country:nk]</column>
            <column>[federated.products].[none:occurred_date:qk]</column>
            <column>[federated.products].[none:segment:nk]</column>
            <column>[federated.products].[none:is_merchandise:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="false" />
            <format attr="background-color" value="#f5f1e8" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <tooltip column="[federated.products].[sum:recorded_value:qk]" />
              <tooltip column="[federated.products].[ctd:invoice_key:qk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true">&lt;[federated.products].[none:month:qk]&gt;
</run>
                <run>Recorded sales · GBP: &lt;[federated.products].[sum:recorded_value:qk]&gt;
</run>
                <run>Purchase invoice: &lt;[federated.products].[ctd:invoice_key:qk]&gt;
</run>
