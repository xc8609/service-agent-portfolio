{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEV-03 trusted manual investigation save",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contact_id",
    "expected_revision",
    "operation_key",
    "statement",
    "recognition",
    "transaction_versions",
    "recognized_transaction_id"
  ],
  "properties": {
    "contact_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483646
    },
    "operation_key": {
      "type": "string",
      "format": "uuid"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "recognition": {
      "enum": [
        "not_recorded",
        "specific_entry",
        "one_purchase_unresolved",
        "both",
        "neither"
      ]
    },
    "transaction_versions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          }
        }
      }
    },
    "recognized_transaction_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
