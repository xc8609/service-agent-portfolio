  "deny_cases": [
    {
      "id": "AUTH-01",
      "given": "Feedback user is in the queue but has not claimed task",
      "action": "transaction.read",
      "expected": "deny details; summary only"
    },
    {
      "id": "AUTH-02",
      "given": "Feedback user claims task atomically with fresh staff session",
      "action": "transaction.read",
      "expected": "allow case-relevant preparation; caller proof not yet required"
    },
    {
      "id": "AUTH-03",
      "given": "Customer has not passed callback verification",
      "action": "customer_disclosure",
      "expected": "deny private disclosure even though staff preparation was permitted"
    },
    {
      "id": "AUTH-04",
      "given": "Task is reassigned after a proposal",
      "action": "proposal.approve",
      "expected": "deny old assignee; preserve draft/audit"
    },
    {
      "id": "AUTH-05",
      "given": "Agent asks for internal result notes",
      "action": "result.read_internal",
      "expected": "deny"
    },
    {
      "id": "AUTH-06",
      "given": "Ordinary representative requests refund",
      "action": "financial.execute",
      "expected": "no callable endpoint; deny"
    },
    {
      "id": "AUTH-07",
      "given": "Two operators claim same work version",
      "action": "work.claim",
      "expected": "one succeeds; other receives STALE_VERSION"
    },
    {
      "id": "AUTH-08",
      "given": "Prompt includes another customer identifier",
      "action": "transaction.read",
      "expected": "scope check rejects without existence disclosure"
    }
  ]
