{
  "version": "0.4",
  "status": "RB-01 through RB-06 accepted as D-17 through D-22; additional technical grants remain candidates",
  "roles": [
    "inbound_representative",
    "specialist",
    "feedback_representative",
    "queue_lead",
    "policy_steward",
    "scheduler",
    "agent_runtime"
