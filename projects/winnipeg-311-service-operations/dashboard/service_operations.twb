    <worksheet name="Open records">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#242424" fontsize="12">Open records</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Ageing" name="federated.ageing" />
          </datasources>
          <datasource-dependencies datasource="federated.ageing">
            <column name="[analysis_group]" caption="Request group" datatype="string" role="dimension" type="nominal" />
            <column name="[waste_stream]" caption="Waste stream" datatype="string" role="dimension" type="nominal" />
            <column name="[request_type]" caption="Request type" datatype="string" role="dimension" type="nominal" />
            <column name="[age_band]" caption="Age at 31 Oct 2026" datatype="string" role="dimension" type="nominal" />
            <column name="[open_cases]" caption="Open records" datatype="integer" role="measure" type="quantitative" default-format="#,##0" />
            <column name="[year_or_more_share]" caption="Open a year or more" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="SUM(IF [age_band] = '5. 365 days or more' THEN [open_cases] ELSE 0 END) / SUM([open_cases])" />
            </column>
