  <actions>
    <action caption="Select request group" name="[Select request group]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="01 Demand and turnaround" type="sheet" worksheet="Cases by request group" />
      <link caption="Select request group" delimiter="," escape="\" expression="tsl:01%20Demand%20and%20turnaround?%5Bfederated.requests%5D.%5Banalysis_group%5D~s0=&lt;[analysis_group]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Cases by request group,Median days to close by year opened" />
        <param name="target" value="01 Demand and turnaround" />
      </command>
    </action>
    <action caption="Select request group for turnaround" name="[Select request group for turnaround]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="01 Demand and turnaround" type="sheet" worksheet="Cases by request group" />
      <link caption="Select request group for turnaround" delimiter="," escape="\" expression="tsl:01%20Demand%20and%20turnaround?%5Bfederated.turnaround%5D.%5Banalysis_group%5D~s0=&lt;[analysis_group]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Cases by request group,Cases,Closed within 7 days,Closed within 30 days,Cases by month,Closed within 7 days by month" />
        <param name="target" value="01 Demand and turnaround" />
      </command>
    </action>
    <action caption="Select open-record group" name="[Select open-record group]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="02 Open records and follow-ups" type="sheet" worksheet="Open records by request group" />
      <link caption="Select open-record group" delimiter="," escape="\" expression="tsl:02%20Open%20records%20and%20follow-ups?%5Bfederated.ageing%5D.%5Banalysis_group%5D~s0=&lt;[analysis_group]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Open records by request group,Follow-ups recorded as breached,Follow-up calls by month · city-wide,Share recorded as SLA breached · city-wide" />
        <param name="target" value="02 Open records and follow-ups" />
      </command>
    </action>
  </actions>
