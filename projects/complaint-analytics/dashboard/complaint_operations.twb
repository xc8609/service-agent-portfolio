          <alias key="&quot;Mortgage&quot;" value="Mortgage" />
          <alias key="&quot;Payday loan, title loan, personal loan, or advance loan&quot;" value="Personal / payday / title loan" />
          <alias key="&quot;Prepaid card&quot;" value="Prepaid card" />
          <alias key="&quot;Vehicle loan or lease&quot;" value="Vehicle loan / lease" />
        </aliases>
      </column>
      <column caption="Routing Team" datatype="string" name="[routing_team]" role="dimension" type="nominal" />
      <column caption="Timely No Count" datatype="integer" default-format="#,##0" name="[timely_no_count]" role="measure" type="quantitative" />
      <column caption="Timely Response Rate" datatype="real" default-format="p0.0%" name="[timely_rate]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([timely_yes_count])+SUM([timely_no_count]) &gt; 0 THEN SUM([timely_yes_count])/(SUM([timely_yes_count])+SUM([timely_no_count])) END" />
      </column>
      <column caption="Timely Unknown Count" datatype="integer" default-format="#,##0" name="[timely_unknown_count]" role="measure" type="quantitative" />
