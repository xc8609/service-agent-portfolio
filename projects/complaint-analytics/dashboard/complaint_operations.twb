      <column caption="complaint_daily.csv" datatype="table" name="[__tableau_internal_object_id__].[complaint_daily.csv_F9ECF8076E6A4D438712D32625E56A1E]" role="measure" type="quantitative" />
      <column caption="Channel" datatype="string" name="[channel]" role="dimension" type="nominal" />
      <column caption="Company Response" datatype="string" name="[company_response]" role="dimension" type="nominal" />
      <column caption="Complaint Count" datatype="integer" default-format="#,##0" name="[complaint_count]" role="measure" type="quantitative" />
      <column caption="Date Received" datatype="date" name="[date_received]" role="dimension" type="ordinal" />
      <column caption="Issue" datatype="string" name="[issue]" role="dimension" type="nominal" />
      <column caption="Narrative Count" datatype="integer" default-format="#,##0" name="[narrative_count]" role="measure" type="quantitative" />
      <column caption="Narrative Coverage" datatype="real" default-format="p0.0%" name="[narrative_coverage]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([complaint_count]) &gt; 0 THEN SUM([narrative_count])/SUM([complaint_count]) END" />
      </column>
      <column caption="No Public Narrative" datatype="integer" default-format="#,##0" name="[no_narrative]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[complaint_count]-[narrative_count]" />
      </column>
      <column caption="Product" datatype="string" name="[product]" role="dimension" type="nominal">
        <aliases>
          <alias key="&quot;Checking or savings account&quot;" value="Checking / savings" />
          <alias key="&quot;Credit card&quot;" value="Credit card" />
